msgid "vale catches style issues (AI tells, hedging, E-Prime) during editing"
msgstr ""
"vale finnur stílvandamál (gervigreindarorðalag, varúðarorð, E-Prime) meðan á "
"ritun stendur"

#: ../../source/howto/vale-integration.rst:79
msgid "snapper enforces line break formatting in CI via ``--check``"
msgstr "snapper framfylgir línuskiptasníðmótun í CI með ``--check``"

